# Stayzy Environment Configuration Example

# Database
# For SQLite (default out of the box):
DATABASE_URL="file:./dev.db"

# For PostgreSQL:
# 1. Update prisma/schema.prisma datasource provider to "postgresql"
# 2. Set your PostgreSQL connection string:
# DATABASE_URL="postgresql://username:password@localhost:5432/stayzy?schema=public"

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEMO_MODE="true"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Kolkata"

# Authentication & Security
AUTH_SECRET="your-secure-random-secret-here"
ADMIN_PIN="123456"

# Payment Adapter Configuration
PAYMENT_PROVIDER="DEMO_ADAPTER"
PAYMENT_WEBHOOK_SECRET="your_webhook_signing_secret"

# Optional Live Payment Provider Keys:
# RAZORPAY_KEY_ID="rzp_live_..."
# RAZORPAY_KEY_SECRET="..."
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
