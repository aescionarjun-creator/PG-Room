{
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "/api/**",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/rooms",
        "destination": "/api/rooms.json"
      },
      {
        "source": "/api/content",
        "destination": "/api/content.json"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}